# OpenSearch connection
OPENSEARCH_HOSTS=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=apigw-access-*
OPENSEARCH_VERIFY_CERTS=true

# Field mapping (override if your index uses different names)
OS_FIELD_SERVICE=service.name.keyword
OS_FIELD_RESP_TIME=response_time_ms
OS_FIELD_STATUS=status
OS_FIELD_PATH=http.path.keyword
OS_FIELD_METHOD=http.method.keyword
OS_FIELD_TIMESTAMP=@timestamp

# Server
CACHE_TTL_SECONDS=60
CORS_ORIGINS=*
LOG_LEVEL=INFO
